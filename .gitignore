# Local .terraform directories
**/.terraform/*
.terraform
**/src/.terraform

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore Checkov external modules
*.external_modules/*

# Ignore node_modules
node_modules

# Ignore cache files
.*cache
__pycache__

# Ignore local plan files
*.tfplan
*-plan.txt
